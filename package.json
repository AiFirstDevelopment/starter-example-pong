{
  "name": "single-player-pong",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:table": "npx wrangler dev --config worker/wrangler.toml --port 8787 --local",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "deploy": "npm run deploy:table && npm run deploy:site",
    "deploy:table": "npx wrangler deploy --config worker/wrangler.toml",
    "deploy:site": "npm run build && npx wrangler pages deploy dist --project-name=pong --branch=main"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@playwright/test": "^1.47.0",
    "@types/node": "^26.3.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.126.0"
  }
}
