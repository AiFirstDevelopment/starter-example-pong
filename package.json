{
  "name": "single-player-pong",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=pong --branch=main"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^26.3.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
